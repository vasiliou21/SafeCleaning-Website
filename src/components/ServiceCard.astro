---
import Icon from './Icon.astro';
const { service } = Astro.props;
const href = `/ypiresies/${service.slug}`;
const label = service.fullTitle ?? service.title;
---
<article class="service">
  <a class="service__img" href={href} aria-label={label}>
    <img {...service.projectPhoto} sizes="(max-width: 360px) 88px, 140px" loading="lazy" />
  </a>
  <div class="service__body">
    <h3><a href={href}>{label}</a></h3>
    <p>{service.short}</p>
    <a class="service__more" href={href}>Δείτε περισσότερα <Icon name="arrow" size={16} stroke={2} /></a>
  </div>
</article>
