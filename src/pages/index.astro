---
import ProjectPhotos from '../components/ProjectPhotos.astro';
import { projectPhotos } from '../data/project-photos.js';
import HomeProjectGallery from '../components/HomeProjectGallery.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, services, reasons, steps } from '../data/site.js';
import { TRACK_LOC, trackContactAttrs } from '../data/tracking.js';

const title = 'Συνεργείο Καθαρισμού Παλλήνη & Αττική | SafeCleaning';
const description =
  'Επαγγελματικό συνεργείο καθαρισμού στην Παλλήνη. Πολυκατοικίες, επαγγελματικοί χώροι & νεόδμητα. Δωρεάν αυτοψία & προσφορά.';
const homeProjects = [
  { photo: projectPhotos.staircase, caption: 'Καθαρισμός κοινόχρηστου κλιμακοστασίου', href: '/ypiresies/katharismoi-polykatoikion/' },
  { photo: projectPhotos.kitchen, caption: 'Καθαρισμός εσωτερικού χώρου', href: '/ypiresies/archikoi-katharismoi/' },
  { photo: projectPhotos.commercial, caption: 'Καθαρισμός επαγγελματικού χώρου', href: '/ypiresies/epaggelmatikoi-choroi/' },
  { photo: projectPhotos.building, caption: 'Καθαρισμός εσωτερικών χώρων κτιρίου', href: '/ypiresies/katharismoi-ktirion/' },
  { photo: projectPhotos.bathroom, caption: 'Καθαρισμός χώρου υγιεινής', href: '/ypiresies/archikoi-katharismoi/' },
];
const iconFor = (i) => reasons[i].icon;
---
<Base title={title} description={description} image="/images/hero.jpg">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__grid">
        <div class="hero__content">
          <span class="eyebrow">Επαγγελματικοί καθαρισμοί · Παλλήνη, Αττική</span>
          <h1>Συνεργείο καθαρισμού στην Παλλήνη & Αττική</h1>
          <p class="hero__lead">Καθαροί χώροι, με συνέπεια και αξιοπιστία</p>
          <p class="hero__sub">
            Οικογενειακή εταιρεία καθαρισμού με έδρα την Παλλήνη. Αναλαμβάνουμε πολυκατοικίες,
            επαγγελματικούς χώρους και κτίρια σε όλη την Αττική, με οικολογικά προϊόντα και σταθερό πρόγραμμα.
          </p>
          <div class="hero__ctas">
            <a href="/epikoinonia" class="btn btn--light">Ζητήστε Προσφορά</a>
            <a
              href={`tel:${company.phoneMobileHref}`}
              class="btn btn--ghost-light"
              {...trackContactAttrs(TRACK_LOC.HERO_HOME, { phoneType: 'mobile' })}
            >
              <Icon name="phone" size={18} stroke={2} /> Καλέστε μας
            </a>
          </div>
          <div class="hero__assure">
            <span><Icon name="check" size={16} stroke={2} /> Δωρεάν αυτοψία & προσφορά</span>
            <span><Icon name="check" size={16} stroke={2} /> Οικολογικά προϊόντα</span>
            <span><Icon name="check" size={16} stroke={2} /> Οικογενειακή επιχείρηση</span>
          </div>
        </div>
      </div>
    </div>
    <HomeProjectGallery />
  </section>

  <TrustStrip />

  <!-- SERVICES -->
  <section class="section" id="ypiresies">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Οι υπηρεσίες μας</span>
        <h2>Καθαρισμοί προσαρμοσμένοι σε κάθε χώρο</h2>
        <p>Αναλαμβάνουμε κοινόχρηστους, επαγγελματικούς και κτιριακούς χώρους με σταθερό πρόγραμμα,
          σύγχρονο εξοπλισμό και οικολογικά προϊόντα καθαρισμού.</p>
      </div>
      <div class="services" data-reveal data-delay="1">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <ProjectPhotos
    id="erga"
    showcase
    items={homeProjects}
    description="Δείτε δουλειές που έχουμε ολοκληρώσει για τους πελάτες μας, από τον καθαρισμό κοινόχρηστων χώρων πολυκατοικίας μέχρι τον καθαρισμό μεγαλύτερων επαγγελματικών χώρων."
  />

  <!-- WHY -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="split">
        <div class="split__media" data-reveal>
          <img {...projectPhotos.team} sizes="(max-width: 920px) 92vw, 45vw" loading="lazy" decoding="async" />
          <div class="badge">
            <strong>Παλλήνη</strong>
            <span>& ευρύτερη Αττική, με άμεση εξυπηρέτηση</span>
          </div>
        </div>
        <div data-reveal data-delay="1">
          <div class="section-head" style="margin-bottom: 26px;">
            <span class="eyebrow">Γιατί SafeCleaning</span>
            <h2>Μια οικογενειακή επιχείρηση που χτίζει σχέσεις</h2>
          </div>
          <p class="lead" style="margin-bottom: 26px;">
            Με έδρα την Παλλήνη Αττικής, εξειδικευόμαστε στον καθαρισμό κτιρίων και επαγγελματικών χώρων.
            Στόχος μας είναι η άριστη εξυπηρέτηση και η ανάπτυξη μακροχρόνιων, ανθρώπινων σχέσεων συνεργασίας.
          </p>
          <ul class="feature-list">
            {reasons.map((r) => (
              <li>
                <span class="feature-ico"><Icon name={r.icon} size={20} /></span>
                <div><h3>{r.title}</h3><p>{r.text}</p></div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- STATEMENT band (brand refrain) -->
  <section class="statement">
    <div class="wrap">
      <div class="statement__inner" data-reveal>
        <p>Καθαριότητα με <span class="accent">συνέπεια και αξιοπιστία</span> — μια οικογενειακή ομάδα, οικολογικά προϊόντα και ένα σταθερό πρόγραμμα που κρατάει.</p>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Πώς συνεργαζόμαστε</span>
        <h2>Από την αυτοψία στο σταθερό πρόγραμμα</h2>
        <p>Τρία απλά βήματα για να ξεκινήσουμε — χωρίς δέσμευση και χωρίς χρέωση για την αρχική εκτίμηση.</p>
      </div>
      <div class="process">
        {steps.map((st, i) => (
          <div class="step" data-reveal data-delay={i + 1}>
            <div class="step__num">{i + 1}</div>
            <h3>{st.title}</h3>
            <p>{st.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED GUIDE -->
  <section class="home-guides" id="arthra" aria-labelledby="home-guides-title">
    <div class="wrap">
      <div class="home-guides__head" data-reveal>
        <div>
          <span class="eyebrow">Χρήσιμοι οδηγοί καθαρισμού</span>
          <h2 id="home-guides-title">Πρακτικές απαντήσεις πριν επιλέξετε συνεργείο</h2>
        </div>
        <a class="home-guides__all" href="/blog">
          Όλα τα άρθρα <Icon name="arrow" size={19} />
        </a>
      </div>

      <article class="featured-guide" data-reveal data-delay="1">
        <a
          class="featured-guide__media"
          href="/blog/katharismos-polykatoikias-ti-perilamvanei/"
          aria-label="Διαβάστε τον οδηγό για τον καθαρισμό πολυκατοικίας"
        >
          <img
            src="/images/blog-polykatoikia-hero.png"
            alt="Καθαρισμός κοινόχρηστου χώρου πολυκατοικίας"
            width="1536"
            height="1024"
            loading="lazy"
          />
        </a>
        <div class="featured-guide__copy">
          <p class="featured-guide__meta">Πολυκατοικίες · Οδηγός για διαχειριστές</p>
          <h3>
            <a href="/blog/katharismos-polykatoikias-ti-perilamvanei/">
              Καθαρισμός πολυκατοικίας: τι περιλαμβάνει, κάθε πότε γίνεται και πόσο κοστίζει
            </a>
          </h3>
          <p>
            Τι πρέπει να γίνεται σε κάθε επίσκεψη, ποιες εργασίες μπαίνουν περιοδικά και ποια στοιχεία
            χρειάζεται μια σωστή προσφορά πριν ξεκινήσει η συνεργασία.
          </p>
          <a class="featured-guide__link" href="/blog/katharismos-polykatoikias-ti-perilamvanei/">
            Διαβάστε τον οδηγό <Icon name="arrow" size={20} />
          </a>
        </div>
      </article>
    </div>
  </section>

  <CtaBand />
</Base>
