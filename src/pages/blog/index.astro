---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';

const title = 'Οδηγός Καθαρισμού | SafeCleaning';
const description = 'Πρακτικοί οδηγοί για καθαρισμό πολυκατοικιών, επαγγελματικών χώρων και αρχικούς καθαρισμούς στην Παλλήνη και την Αττική.';
---
<Base title={title} description={description}>
  <section class="pagehero">
    <div class="wrap wrap--narrow">
      <p class="crumbs"><a href="/">Αρχική</a> / Οδηγός</p>
      <span class="eyebrow">Οδηγός SafeCleaning</span>
      <h1>Πρακτικές απαντήσεις για τον καθαρισμό του χώρου σας</h1>
      <p>Χρήσιμοι οδηγοί για διαχειριστές, ιδιοκτήτες και επιχειρήσεις στην Παλλήνη, την Αττική και τις γύρω περιοχές.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap wrap--narrow">
      <article class="blog-card">
        <span class="eyebrow">Πολυκατοικίες</span>
        <h2><a href="/blog/katharismos-polykatoikias-ti-perilamvanei/">Καθαρισμός πολυκατοικίας: τι περιλαμβάνει ένα σωστό μηνιαίο πρόγραμμα</a></h2>
        <p>Τι περιλαμβάνει κάθε επίσκεψη, ποιες εργασίες γίνονται περιοδικά και τι πρέπει να ζητήσει ο διαχειριστής σε μια προσφορά.</p>
        <a class="row__link" href="/blog/katharismos-polykatoikias-ti-perilamvanei/">Διαβάστε τον οδηγό →</a>
      </article>
    </div>
  </section>
  <CtaBand />
</Base>
